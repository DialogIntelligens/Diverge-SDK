#!/usr/bin/env bash
# Local pre-commit checks for Diverge SDK.
# Installed via: ./scripts/install-git-hooks.sh  (or: make install-hooks)
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "==> pre-commit: version sync"
./scripts/check-version.sh

STAGED="$(git diff --cached --name-only --diff-filter=ACMR || true)"

needs_swift=0
needs_android=0
if printf '%s\n' "$STAGED" | grep -qE '\.swift$|^Package\.swift$|^\.swiftlint\.yml$|^\.swiftformat$'; then
  needs_swift=1
fi
if printf '%s\n' "$STAGED" | grep -qE '^android/'; then
  needs_android=1
fi

if [[ "$needs_swift" -eq 1 ]]; then
  echo "==> pre-commit: SwiftLint"
  if ! command -v swiftlint >/dev/null 2>&1; then
    echo "error: swiftlint not found. Install with: brew install swiftlint" >&2
    exit 1
  fi
  swiftlint lint --strict

  echo "==> pre-commit: SwiftFormat"
  if ! command -v swiftformat >/dev/null 2>&1; then
    echo "error: swiftformat not found. Install with: brew install swiftformat" >&2
    exit 1
  fi
  swiftformat --lint .
fi

if [[ "$needs_android" -eq 1 ]]; then
  echo "==> pre-commit: Android lint (library)"
  if [[ -z "${ANDROID_HOME:-}" && -z "${ANDROID_SDK_ROOT:-}" ]]; then
    echo "error: ANDROID_HOME not set; required when committing android/ changes" >&2
    exit 1
  fi
  (
    cd android
    ./gradlew :diverge-sdk:lint :sample:compileDebugUnitTestKotlin --quiet
  )
fi

echo "==> pre-commit: ok"
